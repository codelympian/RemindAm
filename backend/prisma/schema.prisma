// RemindAm Prisma schema
// Source of truth for application/business data (Postgres via Supabase or local Docker).
// Clerk remains the source of truth for authentication.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  email       String   @unique
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships BusinessMembership[]

  @@map("users")
}

model Business {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  phone                  String?
  email                  String?
  industry               String?
  customerTrackingMethod String?  @map("customer_tracking_method")
  currency               String   @default("NGN")
  timezone               String   @default("Africa/Lagos")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  memberships     BusinessMembership[]
  customers       Customer[]
  products        Product[]
  sales           Sale[]
  leads           Lead[]
  recommendations Recommendation[]
  imports         Import[]

  @@map("businesses")
}

model BusinessMembership {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_memberships")
}

// ─────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  interactions    CustomerInteraction[]
  tags            CustomerTag[]
  sales           Sale[]
  leads           Lead[]
  debts           Debt[]
  recommendations Recommendation[]
  followUps       FollowUp[]

  @@index([businessId])
  @@index([businessId, name])
  @@map("customers")
}

model CustomerInteraction {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  type       String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_interactions")
}

model CustomerTag {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  label      String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, label])
  @@index([customerId])
  @@map("customer_tags")
}

// ─────────────────────────────────────────────
// Products
// ─────────────────────────────────────────────

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  name             String
  sku              String?
  category         String?
  description      String?
  price            Decimal  @default(0) @db.Decimal(14, 2)
  cost             Decimal  @default(0) @db.Decimal(14, 2)
  stockQuantity    Int      @default(0) @map("stock_quantity")
  reorderThreshold Int      @default(0) @map("reorder_threshold")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]
  saleItems SaleItem[]

  // SKUs identify a product within one business's catalogue. Postgres treats
  // NULLs as distinct, so products without a SKU are unaffected.
  @@unique([businessId, sku])
  @@index([businessId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  name      String
  price     Decimal @default(0) @db.Decimal(14, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────────────────────────
// Sales
// ─────────────────────────────────────────────

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  customerId    String?       @map("customer_id") @db.Uuid
  total         Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  soldAt        DateTime      @default(now()) @map("sold_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  debt     Debt?

  @@index([businessId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ─────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @map("business_id") @db.Uuid
  customerId        String?    @map("customer_id") @db.Uuid
  source            String?
  interestedProduct String?    @map("interested_product")
  status            LeadStatus @default(NEW)
  value             Decimal    @default(0) @db.Decimal(14, 2)
  nextFollowUpAt    DateTime?  @map("next_follow_up_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  interactions LeadInteraction[]

  @@index([businessId])
  @@index([customerId])
  @@map("leads")
}

model LeadInteraction {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_interactions")
}

// ─────────────────────────────────────────────
// Debt
// ─────────────────────────────────────────────

model Debt {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  saleId     String?   @unique @map("sale_id") @db.Uuid
  amount     Decimal   @default(0) @db.Decimal(14, 2)
  paidAmount Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("debts")
}

// ─────────────────────────────────────────────
// Recommendations & follow-ups
// ─────────────────────────────────────────────

model Recommendation {
  id          String               @id @default(uuid()) @db.Uuid
  businessId  String               @map("business_id") @db.Uuid
  customerId  String               @map("customer_id") @db.Uuid
  category    RecommendationCategory
  score       Int                  @default(0)
  reasonCodes String[]             @map("reason_codes")
  reasonText  String               @map("reason_text")
  status      RecommendationStatus @default(PENDING)
  createdAt   DateTime             @default(now()) @map("created_at")
  expiresAt   DateTime?            @map("expires_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  suggestedMessage SuggestedMessage?
  followUps        FollowUp[]

  @@index([businessId, status])
  @@index([customerId])
  @@map("recommendations")
}

model SuggestedMessage {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @unique @map("recommendation_id") @db.Uuid
  body             String
  edited           Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@map("suggested_messages")
}

model FollowUp {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  recommendationId String?         @map("recommendation_id") @db.Uuid
  outcome          FollowUpOutcome
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("follow_ups")
}

// ─────────────────────────────────────────────
// Imports
// ─────────────────────────────────────────────

model Import {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  filename     String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0) @map("total_rows")
  validRows    Int          @default(0) @map("valid_rows")
  duplicateRows Int         @default(0) @map("duplicate_rows")
  errorRows    Int          @default(0) @map("error_rows")
  createdAt    DateTime     @default(now()) @map("created_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rows     ImportRow[]

  @@index([businessId])
  @@map("imports")
}

model ImportRow {
  id       String  @id @default(uuid()) @db.Uuid
  importId String  @map("import_id") @db.Uuid
  rowIndex Int     @map("row_index")
  raw      Json
  valid    Boolean @default(false)
  error    String?

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("import_rows")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  WON
  LOST
}

enum RecommendationCategory {
  HOT_LEAD
  REORDER_DUE
  DEBTOR
  REACTIVATION
  VIP
  FOLLOW_UP
}

enum RecommendationStatus {
  PENDING
  CONTACTED
  SNOOZED
  DISMISSED
  EXPIRED
}

enum FollowUpOutcome {
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  PURCHASED
  FOLLOW_UP_LATER
  NO_RESPONSE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
