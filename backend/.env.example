# RemindAm backend environment variables.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Database (Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/remindam?schema=public"

# --- HTTP server ---
PORT=4000
# Comma-separated list of allowed browser origins (the frontend).
CORS_ORIGINS="http://localhost:3000"

# --- Clerk (server-side auth) ---
# Secret key from the Clerk dashboard (same instance as the frontend).
# Starts with sk_test_ (development) or sk_live_ (production).
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: comma-separated frontend origins allowed to mint session tokens
# (the token `azp` claim). Defaults to CORS_ORIGINS when unset.
# CLERK_AUTHORIZED_PARTIES="http://localhost:3000"
