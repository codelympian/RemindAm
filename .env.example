# ─────────────────────────────────────────────
# RemindAm — Environment Variables (example)
# Copy relevant sections into backend/.env and frontend/.env.local
# NEVER commit real secrets.
# ─────────────────────────────────────────────

# ============ BACKEND (backend/.env) ============

# Local Docker Postgres (see docker-compose.yml).
# For Supabase, replace with the Supabase connection string:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://remindam:remindam@localhost:5432/remindam?schema=public"

# Clerk (Phase 1). Backend verifies Clerk-issued tokens.
CLERK_SECRET_KEY=""
CLERK_JWT_ISSUER=""
CLERK_PUBLISHABLE_KEY=""

# Backend server
PORT=4000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS="http://localhost:3000"

# ============ FRONTEND (frontend/.env.local) ============

# Clerk (Phase 1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Base URL of the NestJS backend
NEXT_PUBLIC_API_URL="http://localhost:4000"
